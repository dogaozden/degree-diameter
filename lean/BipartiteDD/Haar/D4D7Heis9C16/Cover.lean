import BipartiteDD.Haar.D4D7Heis9C16.Grp
import BipartiteDD.Haar.D4D7Heis9C16.Cert

/-! The two six-letter covers of `G = Heis(F_9) ⋊ C_16` by the connection set `S`, from the certificates of `Cert`
(generated by research/lean-haarD/gen_d4D7_n864.py). They are the hypotheses `hA`, `hB` of the diameter-7 lemma for Haar
graphs (`BipartiteDD.Haar.Diam7`). -/

namespace BipartiteDD.Haar.D4D7Heis9C16

/-- The connection set `S` as a finset. -/
def SS : Finset Grp := {s0, s1, s2, s3}

/-- The letters of `S`, indexed by `Fin 4`. -/
def sel (i : Fin 4) : Grp := if i = 0 then s0 else if i = 1 then s1 else if i = 2 then s2 else s3

theorem sel_mem (i : Fin 4) : sel i ∈ SS := by
  fin_cases i <;> decide +kernel

theorem card_SS : SS.card = 4 := by decide +kernel

/-- Letter `k` of the A-word of element `n`, as an index into `S`. -/
def cA (n : ℕ) (k : ℕ) : Fin 4 := (certA.getD n []).getD k 0

/-- Letter `k` of the B-word of element `n`, as an index into `S`. -/
def cB (n : ℕ) (k : ℕ) : Fin 4 := (certB.getD n []).getD k 0

theorem certA_ok : ∀ n : Fin 432, grpOf n.val = (sel (cA n 0))⁻¹ * sel (cA n 1) * (sel (cA n 2))⁻¹ *
    sel (cA n 3) * (sel (cA n 4))⁻¹ * sel (cA n 5) := by
  decide +kernel

theorem certB_ok : ∀ n : Fin 432, grpOf n.val = sel (cB n 0) * (sel (cB n 1))⁻¹ * sel (cB n 2) *
    (sel (cB n 3))⁻¹ * sel (cB n 4) * (sel (cB n 5))⁻¹ := by
  decide +kernel

theorem cover1 : ∀ g : Grp, ∃ x1 ∈ SS, ∃ x2 ∈ SS, ∃ x3 ∈ SS, ∃ x4 ∈ SS, ∃ x5 ∈ SS, ∃ x6 ∈ SS,
    g = x1⁻¹ * x2 * x3⁻¹ * x4 * x5⁻¹ * x6 := by
  intro g
  have h := certA_ok ⟨enc g, enc_lt g⟩
  change grpOf (enc g) = _ at h
  rw [grpOf_enc] at h
  exact ⟨_, sel_mem _, _, sel_mem _, _, sel_mem _, _, sel_mem _, _, sel_mem _, _, sel_mem _, h⟩

theorem cover2 : ∀ g : Grp, ∃ x1 ∈ SS, ∃ x2 ∈ SS, ∃ x3 ∈ SS, ∃ x4 ∈ SS, ∃ x5 ∈ SS, ∃ x6 ∈ SS,
    g = x1 * x2⁻¹ * x3 * x4⁻¹ * x5 * x6⁻¹ := by
  intro g
  have h := certB_ok ⟨enc g, enc_lt g⟩
  change grpOf (enc g) = _ at h
  rw [grpOf_enc] at h
  exact ⟨_, sel_mem _, _, sel_mem _, _, sel_mem _, _, sel_mem _, _, sel_mem _, _, sel_mem _, h⟩

end BipartiteDD.Haar.D4D7Heis9C16

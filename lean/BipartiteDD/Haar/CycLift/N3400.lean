import BipartiteDD.Haar.CycLift.Lift

/-! The (3,13) graph on 3400 vertices: a regular `Z_170` voltage lift of a 20-vertex cubic base graph.

Edge list: `research/frontier/beyond/graphs/d3D13_n3400_lift_gp10_Z170.edges.gz`
(uncompressed sha256 `68a0d7feea71e65bf94ad60b2970414431a2e41f38ae4c0b32d339f2333d536a`).
Base vertex `w` and fibre `x` give the vertex `w * 170 + x`. `outA3400` lists, for each base vertex `w`, the arcs
`(u, β)`: `(w, x) ~ (u, x + β)`. Generated by `research/lean-haarD/gen_cyclift.py`, which checks that this formula
gives exactly the edges of the file, and that the graph has diameter 13 by a BFS from every vertex. -/

namespace BipartiteDD.CycLift

/-- The arcs out of each base vertex, with their voltages in `Z_170`. -/
def outA3400 : List (List (ℕ × ℕ)) := [
  [(10, 0), (11, 0), (19, 0)],
  [(11, 0), (13, 120), (15, 0)],
  [(10, 0), (13, 0), (14, 0)],
  [(10, 0), (12, 0), (17, 0)],
  [(14, 0), (16, 5), (17, 9)],
  [(12, 43), (13, 0), (16, 0)],
  [(11, 0), (12, 6), (18, 0)],
  [(15, 0), (16, 156), (18, 82)],
  [(14, 33), (15, 145), (19, 0)],
  [(17, 32), (18, 136), (19, 0)],
  [(0, 0), (2, 0), (3, 0)],
  [(0, 0), (1, 0), (6, 0)],
  [(3, 0), (5, 127), (6, 164)],
  [(1, 50), (2, 0), (5, 0)],
  [(2, 0), (4, 0), (8, 137)],
  [(1, 0), (7, 0), (8, 25)],
  [(4, 165), (5, 0), (7, 14)],
  [(3, 0), (4, 161), (9, 138)],
  [(6, 0), (7, 88), (9, 34)],
  [(0, 0), (8, 0), (9, 0)]]

/-- A proper 2-colouring of the base graph. -/
def side3400 : List Bool := [false, false, false, false, false, false, false, false, false, false, true, true, true, true, true, true, true, true, true, true]

/-- The lift. -/
def G3400 : SimpleGraph (Fin 3400) := liftGraph 3400 170 outA3400

theorem G3400_isBipartiteDegDiam : IsBipartiteDegDiam G3400 3 13 :=
  isBipartiteDegDiam_of_checks (b := 20) side3400 rfl (by decide) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel)

end BipartiteDD.CycLift

open BipartiteDD in
/-- A bipartite graph on 3400 vertices, of degree at most 3 and diameter at most 13. -/
theorem nb_3_13_3400 : ∃ G : SimpleGraph (Fin 3400), IsBipartiteDegDiam G 3 13 :=
  ⟨_, CycLift.G3400_isBipartiteDegDiam⟩

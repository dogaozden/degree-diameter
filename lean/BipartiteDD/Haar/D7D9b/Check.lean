import BipartiteDD.Haar.D7D9b.Raw

/-! The covering certificates of the (7,9) record on `PSL(2, 29) × Z_19`, checked by kernel computation.

For each index `n < 231420` a code `c` (a base-7 number with digits `d0 … d7`) gives two words, `wordA c` and
`wordB c` (in `D7D9b.Raw`), whose indices are computed by the raw arithmetic `rwA`, `rwB`. The predicate `chkA`
checks, for the code of each index of a stage, that the raw A-word has that index; `chkA_spec` turns the check
into the statement about `idxG (wordA c)`. The certificate tables are the stage modules `D7D9b.Stage00 …
Stage41`, generated by research/lean-haarD/gen_d7D9b.py. Each stage is checked by `decide +kernel`. -/

namespace BipartiteDD.Haar.D7D9b

/-- A stage table is a natural number `C` holding codes, `23` bits each, the code `i` in bits `[23 i, 23 i + 23)`.
Every code is below `7 ^ 8 < 2 ^ 23`. -/
def codeAt (C i : ℕ) : ℕ := (C >>> (23 * i)) % 8388608

/-- `chkA base len C` checks that the code `i` of the table `C` gives the raw A-word of the index `base + i`,
for `i < len`. -/
def chkA (base len C : ℕ) : Bool :=
  (List.range len).all (fun i => encRaw (rwA (codeAt C i)).1 * 19 + (rwA (codeAt C i)).2 == base + i)

/-- `chkB base len C` checks that the code `i` of the table `C` gives the raw B-word of the index `base + i`,
for `i < len`. -/
def chkB (base len C : ℕ) : Bool :=
  (List.range len).all (fun i => encRaw (rwB (codeAt C i)).1 * 19 + (rwB (codeAt C i)).2 == base + i)

theorem chkA_spec {base len C : ℕ} (h : chkA base len C = true) (i : ℕ) (hi : i < len) :
    idxG (wordA (codeAt C i)) = base + i := by
  have h2 := List.all_eq_true.mp h i (List.mem_range.mpr hi)
  rw [idxG_wordA]
  exact beq_iff_eq.mp h2

theorem chkB_spec {base len C : ℕ} (h : chkB base len C = true) (i : ℕ) (hi : i < len) :
    idxG (wordB (codeAt C i)) = base + i := by
  have h2 := List.all_eq_true.mp h i (List.mem_range.mpr hi)
  rw [idxG_wordB]
  exact beq_iff_eq.mp h2

/-- Elements of `G` with equal indices are equal. -/
theorem eq_of_idxG_eq {w g : G} (h : idxG w = idxG g) : w = g := by
  have e := gOf_idxG g
  rw [← h, gOf_idxG] at e
  exact e

/-- An index `n` in the stage `[base, base + len)` has an A-code, given the stage check. -/
theorem stageExA (base len C : ℕ) (h : chkA base len C = true) (n : ℕ) (hn : base ≤ n)
    (hn' : n < base + len) : ∃ c, idxG (wordA c) = n := by
  refine ⟨codeAt C (n - base), ?_⟩
  have := chkA_spec h (n - base) (by omega)
  rwa [show base + (n - base) = n by omega] at this

/-- An index `n` in the stage `[base, base + len)` has a B-code, given the stage check. -/
theorem stageExB (base len C : ℕ) (h : chkB base len C = true) (n : ℕ) (hn : base ≤ n)
    (hn' : n < base + len) : ∃ c, idxG (wordB c) = n := by
  refine ⟨codeAt C (n - base), ?_⟩
  have := chkB_spec h (n - base) (by omega)
  rwa [show base + (n - base) = n by omega] at this

end BipartiteDD.Haar.D7D9b

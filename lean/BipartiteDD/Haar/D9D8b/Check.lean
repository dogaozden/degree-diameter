import BipartiteDD.Haar.D9D8b.Gens

/-! The covering certificates of the Δ9·D8 record, checked by kernel computation.

The connection set `SS` has nine elements `S[0] … S[8]` (`sG i`). For a code `c` (base 9, digits `d₀ … d₆`)
the word is `wE c = S[d₀] (S[d₁]⁻¹ S[d₂]) (S[d₃]⁻¹ S[d₄]) (S[d₅]⁻¹ S[d₆])`. The index `n` has code `c` when
`gOf n = wE c`. Stage constants pack the codes, `23` bits each, and `stageEx` reads one back. The stage modules
`D9D8b.Stage00 … Stage57` are generated by research/lean-haarD/d9D8b/gen_d9D8b.py. -/

namespace BipartiteDD.Haar.D9D8b

/-- The generator `i`, for `i < 9`. -/
def sG (i : ℕ) : G := sGl.getD i 1

/-- The generators as a finset. -/
def SS : Finset G := (Finset.range 9).image sG

theorem sG_mem {i : ℕ} (hi : i < 9) : sG i ∈ SS :=
  Finset.mem_image.2 ⟨i, Finset.mem_range.2 hi, rfl⟩

theorem card_SS : SS.card = 9 := by
  decide +kernel

/-- The `k`-th base-9 digit of the code `c`. -/
def dig (c k : ℕ) : ℕ := c / 9 ^ k % 9

theorem dig_lt (c k : ℕ) : dig c k < 9 :=
  Nat.mod_lt _ (by norm_num)

/-- The word of the code `c`: `S[d₀] (S[d₁]⁻¹ S[d₂]) (S[d₃]⁻¹ S[d₄]) (S[d₅]⁻¹ S[d₆])`. -/
def wE (c : ℕ) : G :=
  sG (dig c 0) * ((sG (dig c 1))⁻¹ * sG (dig c 2)) * ((sG (dig c 3))⁻¹ * sG (dig c 4)) *
    ((sG (dig c 5))⁻¹ * sG (dig c 6))

/-- The code `c` gives the word of the element with index `n`. -/
def chkE (n c : ℕ) : Bool := decide (gOf n = wE c)

/-- The code of the `i`-th index of a stage: `23` bits at `[23 i, 23 i + 23)`. -/
def codeAt (C i : ℕ) : ℕ := (C >>> (23 * i)) % 8388608

/-- `chkStage base len C` checks that the code `i` of the table `C` is a code for the index `base + i`,
for `i < len`. -/
def chkStage (base len C : ℕ) : Bool :=
  (List.range len).all (fun i => chkE (base + i) (codeAt C i))

/-- An index `n` in the stage `[base, base + len)` has a code, given the stage check. -/
theorem stageEx (base len C : ℕ) (h : chkStage base len C = true) (n : ℕ) (hn : base ≤ n)
    (hn' : n < base + len) : ∃ c, chkE n c = true := by
  refine ⟨codeAt C (n - base), ?_⟩
  have := List.all_eq_true.mp h (n - base) (List.mem_range.mpr (by omega))
  rwa [show base + (n - base) = n by omega] at this

end BipartiteDD.Haar.D9D8b

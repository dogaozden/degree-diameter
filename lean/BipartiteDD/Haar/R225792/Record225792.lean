theorem toG_surj (x : G8) : ∃ i j z : ℕ, i < 168 ∧ j < 336 ∧ z < 2 ∧ toG (i, j, z) = x := by
  obtain ⟨p, q, z⟩ := x
  obtain ⟨i, rfl⟩ := fP_surj p
  obtain ⟨j, rfl⟩ := fS_surj q
  obtain ⟨k, hk⟩ := fZ_surj (Multiplicative.toAdd z)
  refine ⟨i.val, j.val, k.val, i.isLt, j.isLt, k.isLt, ?_⟩
  rw [show toG (i.val, j.val, k.val) = (fP i, fS j, fZ k) by simp [toG, f168_val, f336_val, f2_val]]
  exact Prod.ext rfl (Prod.ext rfl hk)

/-- Every element of `G8` has its three covering words. -/
theorem all_good (x : G8) : ∃ wA wB wC : ℕ, prodA wA = x ∧ prodB wB = x ∧ prodC wC = x := by
  obtain ⟨i, j, z, hi, hj, hz, rfl⟩ := toG_surj x
  have hk : i / 6 < 28 := by omega
  have hs := checkStage_sound (i := i) (j := j) (z := z) (stage_all hk) rfl (by omega) (by omega)
  obtain ⟨h1, h2, h3⟩ := checkOneI_sound hs
  exact ⟨_, _, _, h1, h2, h3⟩

/-- The connection set `S` of the record, as a finset of `G8`. -/
def S8 : Finset G8 := Finset.univ.image sS

theorem sS_inj' : ∀ a b : Fin 8, sS a = sS b → a = b := by
  decide +kernel

theorem sS_inj : Function.Injective sS := fun a b h => sS_inj' a b h

theorem sN_mem (k : ℕ) : sN k ∈ S8 :=
  Finset.mem_image_of_mem sS (Finset.mem_univ _)

theorem S8_card : S8.card = 8 := by
  rw [S8, Finset.card_image_of_injective _ sS_inj]
  simp


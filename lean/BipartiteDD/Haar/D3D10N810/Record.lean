import BipartiteDD.Basic
import BipartiteDD.Fast
import BipartiteDD.Haar.D3D10N810.Graph

/-! The (3,10) record on 810 vertices: a regular voltage lift of a 5+5 cubic bipartite base over `G = C3 x He3`
(order 81, `He3` the Heisenberg group of 3x3 unitriangular matrices over GF(3); base and voltages from
`research/squads/own-small/records/d3D10_n810_c3xheis27.txt`). The neighbour lists are the edge file
`d3D10_n810_c3xheis27.edges` (`D3D10N810.Graph`, generated by research/lean-haarD/gen_lift_gaps.py). The check is
`Fast.check_of_fast` (a kernel-friendly `check`), evaluated by `decide +kernel`. -/

open BipartiteDD in
/-- A graph on 810 vertices, bipartite, of degree at most 3 and diameter at most 10. -/
theorem nb_3_10_810 : ∃ G : SimpleGraph (Fin 810), BipartiteDD.IsBipartiteDegDiam G 3 10 :=
  ⟨_, BipartiteDD.check_sound 3 10 BipartiteDD.Haar.D3D10N810.nbrs BipartiteDD.Haar.D3D10N810.color
    (BipartiteDD.Fast.check_of_fast 10 3 10 BipartiteDD.Haar.D3D10N810.adjL BipartiteDD.Haar.D3D10N810.colL
      (by decide) (by decide +kernel))⟩

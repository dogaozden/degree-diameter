# Usage: gapw -c 'ORDER:=176; OUTDIR:="groups"; IDS:=[17];' tools/gap_tabaut.g   (IDS optional; AUTCAP optional, default 400000)
# Writes OUTDIR/sg_<ORDER>_<i>.tab: line 1 "m", then m rows of the multiplication table (identity = 0);
# then "ngen k" and k lines (generators of Aut(G)); then "naut k" and k lines, each the images of the m elements under one automorphism (only with FULL:=true: all of Aut(G) if |Aut| <= AUTCAP,
# else the elements of a subgroup generated by the first generators, still a valid symmetry group).
# OUTDIR/sg_<ORDER>_<i>.name: StructureDescription, |Aut|.
if not IsBound(IDS) then IDS := [1..NrSmallGroups(ORDER)]; fi;
if not IsBound(AUTCAP) then AUTCAP := 400000; fi;
if not IsBound(FULL) then FULL := false; fi;
for i in IDS do
  G := SmallGroup(ORDER, i);
  el := Elements(G);
  e := Position(el, One(G));
  el := Concatenation([el[e]], el{Difference([1..Size(G)], [e])});
  fn := Concatenation(OUTDIR, "/sg_", String(ORDER), "_", String(i), ".tab");
  out := OutputTextFile(fn, false);
  SetPrintFormattingStatus(out, false);
  AppendTo(out, String(ORDER), "\n");
  for g in el do
    AppendTo(out, JoinStringsWithSeparator(List(el, h -> String(Position(el, g*h) - 1)), " "), "\n");
  od;
  A := AutomorphismGroup(G); gens0 := GeneratorsOfGroup(A);
  sz := Size(A);
  if not FULL then L := []; elif sz <= AUTCAP then L := AsList(A); else
    gens := GeneratorsOfGroup(A); B := TrivialSubgroup(A); j := 0;
    while j < Length(gens) and Size(ClosureGroup(B, gens[j+1])) <= AUTCAP do j := j + 1; B := ClosureGroup(B, gens[j]); od;
    L := AsList(B);
  fi;
  AppendTo(out, "ngen ", String(Length(gens0)), "\n");
  for a in gens0 do AppendTo(out, JoinStringsWithSeparator(List(el, h -> String(Position(el, Image(a, h)) - 1)), " "), "\n"); od;
  AppendTo(out, "naut ", String(Length(L)), "\n");
  for a in L do
    AppendTo(out, JoinStringsWithSeparator(List(el, h -> String(Position(el, Image(a, h)) - 1)), " "), "\n");
  od;
  CloseStream(out);
  PrintTo(Concatenation(OUTDIR, "/sg_", String(ORDER), "_", String(i), ".name"),
          StructureDescription(G), " |Aut|=", String(sz), " used=", String(Length(L)), " abelian=", IsAbelian(G), "\n");
od;
QUIT;

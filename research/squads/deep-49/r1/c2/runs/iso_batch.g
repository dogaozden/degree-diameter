SetPrintFormattingStatus("*stdout*", false);
mk := function(m,k,r)
  local F, G;
  F := FreeGroup("a","b");
  G := F / [F.1^m, F.2^k, F.2*F.1*F.2^-1*F.1^-r];
  return Image(IsomorphismPcGroup(G));
end;
L := [[208,12,23,"g2496_208_12_23",208,12,95,"g2496_208_12_95"],[208,12,55,"g2496_208_12_55",208,12,159,"g2496_208_12_159"],[19,132,8,"g2508_19_132_8",209,12,12,"g2508_209_12_12"],[38,66,27,"g2508_38_66_27",418,6,221,"g2508_418_6_221"],[21,120,2,"g2520_21_120_2",105,24,11,"g2520_105_24_11"],[21,120,5,"g2520_21_120_5",105,24,26,"g2520_105_24_26"],[28,90,3,"g2520_28_90_3",140,18,31,"g2520_140_18_31"],[28,90,11,"g2520_28_90_11",140,18,11,"g2520_140_18_11"],[42,60,5,"g2520_42_60_5",210,12,101,"g2520_210_12_101"],[42,60,11,"g2520_42_60_11",210,12,11,"g2520_210_12_11"],[84,30,5,"g2520_84_30_5",420,6,101,"g2520_420_6_101"],[84,30,11,"g2520_84_30_11",420,6,11,"g2520_420_6_11"]];
for x in L do
  G1 := mk(x[1],x[2],x[3]); G2 := mk(x[5],x[6],x[7]);
  if Size(G1) = Size(G2) and IsomorphismGroups(G1,G2) <> fail then Print("ISO ", x[4], " ", x[8], "\n");
  else Print("NONISO ", x[4], " ", x[8], "\n"); fi;
od;
QUIT;

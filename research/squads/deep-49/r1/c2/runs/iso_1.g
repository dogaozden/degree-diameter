SetPrintFormattingStatus("*stdout*", false);
mk := function(m,k,r)
  local F, G;
  F := FreeGroup("a","b");
  G := F / [F.1^m, F.2^k, F.2*F.1*F.2^-1*F.1^-r];
  return Image(IsomorphismPcGroup(G));
end;
